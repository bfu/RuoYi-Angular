<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ruoyi.dsp.mapper.DspDataSourceMapper">

    <resultMap type="DspDataSource" id="DspDataSourceResult">
        <id     property="dataSourceId"    column="data_source_id"    />
        <result property="name"            column="name"              />
        <result property="dbType"          column="db_type"           />
        <result property="driverClassName" column="driver_class_name" />
        <result property="url"             column="url"               />
        <result property="username"        column="username"          />
        <result property="password"        column="password"          />
        <result property="status"          column="status"            />
        <result property="createBy"        column="create_by"         />
        <result property="createTime"      column="create_time"       />
        <result property="updateBy"        column="update_by"         />
        <result property="updateTime"      column="update_time"       />
        <result property="remark"          column="remark"            />
    </resultMap>

    <!-- 列表与下拉不返回密码 -->
    <sql id="selectDspDataSourceVo">
        select data_source_id, name, db_type, driver_class_name, url, username, status, create_by, create_time, update_by, update_time, remark
        from dsp_data_source
    </sql>

    <select id="selectDspDataSourceList" parameterType="DspDataSource" resultMap="DspDataSourceResult">
        <include refid="selectDspDataSourceVo"/>
        <where>
            <if test="name != null and name != ''"> and name like concat('%', #{name}, '%')</if>
            <if test="dbType != null and dbType != ''"> and db_type = #{dbType}</if>
            <if test="status != null and status != ''"> and status = #{status}</if>
        </where>
        order by update_time desc, data_source_id desc
    </select>

    <select id="selectDspDataSourceById" parameterType="Long" resultMap="DspDataSourceResult">
        select data_source_id, name, db_type, driver_class_name, url, username, password, status, create_by, create_time, update_by, update_time, remark
        from dsp_data_source
        where data_source_id = #{dataSourceId}
    </select>

    <select id="selectEnabledDataSourceList" resultMap="DspDataSourceResult">
        <include refid="selectDspDataSourceVo"/>
        where status = '0'
        order by name
    </select>

    <select id="selectDspDataSourceByName" parameterType="String" resultMap="DspDataSourceResult">
        <include refid="selectDspDataSourceVo"/>
        where name = #{name} limit 1
    </select>

    <insert id="insertDspDataSource" parameterType="DspDataSource" useGeneratedKeys="true" keyProperty="dataSourceId">
        insert into dsp_data_source(
            <if test="name != null and name != ''">name,</if>
            <if test="dbType != null">db_type,</if>
            <if test="driverClassName != null and driverClassName != ''">driver_class_name,</if>
            <if test="url != null and url != ''">url,</if>
            <if test="username != null">username,</if>
            <if test="password != null">password,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            <if test="remark != null">remark,</if>
            create_time
        )values(
            <if test="name != null and name != ''">#{name},</if>
            <if test="dbType != null">#{dbType},</if>
            <if test="driverClassName != null and driverClassName != ''">#{driverClassName},</if>
            <if test="url != null and url != ''">#{url},</if>
            <if test="username != null">#{username},</if>
            <if test="password != null">#{password},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            <if test="remark != null">#{remark},</if>
            sysdate()
        )
    </insert>

    <update id="updateDspDataSource" parameterType="DspDataSource">
        update dsp_data_source
        <set>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="dbType != null">db_type = #{dbType},</if>
            <if test="driverClassName != null and driverClassName != ''">driver_class_name = #{driverClassName},</if>
            <if test="url != null and url != ''">url = #{url},</if>
            <if test="username != null">username = #{username},</if>
            <if test="password != null">password = #{password},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            update_time = sysdate()
        </set>
        where data_source_id = #{dataSourceId}
    </update>

    <delete id="deleteDspDataSourceByIds" parameterType="Long">
        delete from dsp_data_source where data_source_id in
        <foreach collection="array" item="dataSourceId" open="(" separator="," close=")">
            #{dataSourceId}
        </foreach>
    </delete>

</mapper>
